# DISCIPLE web — copy to .env.local. Never commit real secrets.
# Privy (auth + embedded EOA that owns the user's Alchemy MAv2 smart account). Public app id.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: separate Privy DEV app id used only on Vercel preview deployments (VERCEL_ENV=preview).
NEXT_PUBLIC_PRIVY_APP_ID_PREVIEW=
# Server only — reserved for verifying Privy access tokens; never NEXT_PUBLIC_.
PRIVY_APP_SECRET=
# DiscipleSessionPolicy v1.1.1 on RH testnet 46630 (moduleId disciple.session-policy.1.1.1, PR #60).
# Empty ⇒ one-tap hidden, the Privy owner signs every trade.
NEXT_PUBLIC_SESSION_POLICY=0x0399d58C802CfEfE0A559Fe9bBC147Ad92212bE2
# 1 ⇒ buys include ReferralRegistry.tryAttribute and the session key gets P_REFERRAL (policy v1.1.1).
NEXT_PUBLIC_REFERRAL_ATTRIBUTE=
# Server only: Alchemy key for /api/bundler (RH testnet, self-pay, no gas policy).
ALCHEMY_API_KEY=
# Server only: drip faucet / self-bundler relayer key.
DRIP_FAUCET_KEY=
# Optional
# NEXT_PUBLIC_AA_BUNDLER_URL=/api/bundler
# NEXT_PUBLIC_AA_SIGNER=local   # dev: browser-key owner instead of Privy
# NEXT_PUBLIC_RHT_RPC_URL=

# ── Creator claims / verification review ────────────────────────────────────────────
# Admins for /admin/verify: comma-separated emails linked to their Privy login (email or Google).
# Unset or blank = admin API returns 503 (fail closed).
ADMIN_EMAILS=
# Privy access-token verification key (PEM from the Privy dashboard). Optional: falls back to the app's JWKS.
PRIVY_VERIFICATION_KEY=
# Preview-deploy variants (used when NEXT_PUBLIC_VERCEL_ENV=preview)
PRIVY_APP_SECRET_PREVIEW=
PRIVY_VERIFICATION_KEY_PREVIEW=
# Redeploy claim features (crew rewards, creator token share, referral deposit):
#   1 = on, 0 = off, unset = auto (on once the redeploy ABIs land). Each also needs its on-chain probe to pass.
NEXT_PUBLIC_REDEPLOY_CLAIMS=
# REDEPLOY: UsdgDepositNotifier address (RH testnet). Zero/unset hides the referral deposit UI.
NEXT_PUBLIC_RHT_DEPOSIT_NOTIFIER=
# Optional indexer REST base (indexer/). Unset = history from RPC logs.
NEXT_PUBLIC_INDEXER_URL=
# Allow ?demo=1 sample data on production builds (screenshots only). Leave unset.
NEXT_PUBLIC_CLAIMS_DEMO=
