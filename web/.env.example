# DISCIPLE web — copy to .env.local. Never commit real secrets.
# Privy (auth + embedded EOA that owns the user's Alchemy MAv2 smart account). Public app id.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: separate Privy DEV app id used only on Vercel preview deployments (VERCEL_ENV=preview).
NEXT_PUBLIC_PRIVY_APP_ID_PREVIEW=
# Server only — verifies Privy access tokens / looks up linked accounts (/api/pve/attest); never NEXT_PUBLIC_.
PRIVY_APP_SECRET=
# Server only: secret of the PREVIEW Privy app (pairs with NEXT_PUBLIC_PRIVY_APP_ID_PREVIEW on VERCEL_ENV=preview).
PRIVY_APP_SECRET_PREVIEW=
# DiscipleSessionPolicy for the v4 stack on RH testnet 46630 (moduleId disciple.session-policy.1.3.0,
# contracts/deployments/rh-testnet-46630.json addons.DiscipleSessionPolicy). Empty ⇒ one-tap hidden.
NEXT_PUBLIC_SESSION_POLICY=0x3d3667e8880c6b633b424d645b8004788b1d6e27
NEXT_PUBLIC_SESSION_POLICY_VERSION=1.3.0
# PVE login attester (LoginGate EIP-712 signer). Server only, Vercel *sensitive*. The on-chain LoginGate.attester must
# equal this key's address or /api/pve/attest answers 503 attester_not_registered (fail closed). Empty ⇒ PVE buys off.
PVE_ATTESTER_PRIVATE_KEY=
# Attestation lifetime in seconds (default 43200 = 12h; clamped below LoginGate.MAX_TTL = 24h).
# PVE_ATTEST_TTL_SEC=43200
# Launch ABI: auto ("modes" ⇒ launchWithMode when the generated ABI has it). "current" forces legacy launch(params).
# NEXT_PUBLIC_LAUNCH_ABI=
# Server only: self-bundler relayer (also relays LoginGate.attest and pokes QuotePricer). Production fails closed without it.
RELAYER_PRIVATE_KEY=
# Server only: Vercel Cron bearer secret for /api/cron/* (poke-pricer every minute).
CRON_SECRET=
# QuotePricer keeper knobs: extra comma-separated base tokens to poke; 1 ⇒ skip pokes.
# PRICER_EXTRA_BASES=
# PRICER_KEEPER_DISABLED=
# 1 ⇒ buys include ReferralRegistry.tryAttribute and the session key gets P_REFERRAL (policy v1.1.1).
NEXT_PUBLIC_REFERRAL_ATTRIBUTE=
# Server only: Alchemy key for /api/bundler (RH testnet, self-pay, no gas policy).
ALCHEMY_API_KEY=
# Server only: drip faucet / self-bundler relayer key.
DRIP_FAUCET_KEY=
# Optional
# NEXT_PUBLIC_AA_BUNDLER_URL=/api/bundler
# NEXT_PUBLIC_AA_SIGNER=local   # dev: browser-key owner instead of Privy
# NEXT_PUBLIC_RHT_RPC_URL=

# ── Claims / verified badge review ──────────────────────────────────────────────────
# Admins for /admin/verifications: comma-separated emails on their Privy login (email or Google).
# Unset or blank ⇒ the page shows "No admins configured" and the admin API answers 503 (fail closed).
ADMIN_EMAILS=
# Optional Privy access-token verification key (PEM from the Privy dashboard). Falls back to the app's JWKS.
PRIVY_VERIFICATION_KEY=
PRIVY_VERIFICATION_KEY_PREVIEW=
# Optional indexer REST base (indexer/). Unset = history from RPC logs; pending amounts are always read on-chain.
NEXT_PUBLIC_INDEXER_URL=
# Allow ?demo=1 sample data on production builds (screenshots only). Leave unset.
NEXT_PUBLIC_CLAIMS_DEMO=
# Address overrides (defaults = v4 deployment json): NEXT_PUBLIC_RHT_LOGIN_GATE, NEXT_PUBLIC_RHT_USDG_DEPOSIT_NOTIFIER, …
