# Copy to .env (never commit it). Only RPC_URL is commonly needed; leave it unset to use the public RH testnet RPC.
RPC_URL=
# Address source: the web bundle (current v3 stack) or contracts/deployments/rh-testnet-46630.json (walks `previous` → v1,v2,v3)
DEPLOYMENT_JSON=../contracts/deployments/web-bundle/addresses.json
STACK_ID=v3
# Optional: restrict stacks (comma list) / override newest stack start block (after a redeploy)
STACKS=
START_BLOCK=
# Extra stack json appended after the main chain (e.g. the PR #44 redeploy) and its id
EXTRA_DEPLOYMENT=
EXTRA_STACK_ID=v4
# DiscipleHook (Robinhood 4663). Off unless set. Does not replace AscensionHook indexing.
# Whole-hook mode (no Launchpad stacks): DEPLOYMENT_JSON=../contracts/deployments/rh-4663-disciple-hook.json
# Beside the testnet stacks: DISCIPLE_HOOK=0xcEdc3C312C5B3C4310F0fba0323DDeC797E4aA88 and DISCIPLE_RPC_URL to mainnet.
DISCIPLE_HOOK=
DISCIPLE_FROM_BLOCK=
DISCIPLE_RPC_URL=
DISCIPLE_POOL_MANAGER=
DISCIPLE_V4_QUOTER=
# quote USD WAD per 1e18 raw, comma list. 6-dec USDG at $1 = 1e30.
DISCIPLE_QUOTE_USD=
DB_PATH=./disciple-indexer.sqlite
PORT=4200
POLL_MS=4000
# Reorg / RPC tuning
CONFIRMATIONS=2
REORG_DEPTH=64
RPC_RPS=20
LOG_CHUNK=20000
MIN_LOG_CHUNK=500
