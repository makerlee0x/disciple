{
  "name": "@disciple/keeper",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source keeper for Disciple cross-chain pools: pushes home-chain source prices over LayerZero and self-delivers them on the destination.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/main.ts",
    "once": "node src/main.ts --once",
    "status": "node src/main.ts --status",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "2.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
