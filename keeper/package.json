{
  "name": "@disciple/keeper",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source keeper for Disciple pools: samples same-chain pools for jar tips, and pushes cross-chain prices over LayerZero and self-delivers them.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "once": "node src/main.ts --once",
    "status": "node src/main.ts --status",
    "collect": "node src/main.ts --collect",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "2.57.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
