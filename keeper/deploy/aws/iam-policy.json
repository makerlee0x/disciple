{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadKeeperSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": "arn:aws:ssm:*:*:parameter/carry-keeper/*"
    },
    {
      "Sid": "DecryptWithTheSsmKey",
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": "*",
      "Condition": { "StringLike": { "kms:ViaService": "ssm.*.amazonaws.com" } }
    }
  ]
}
