# Non-secret params for the single DISCIPLE redeploy on RH testnet 46630 (PRIVATE_KEY comes from the secrets file).
# Steep curve #1 + 16-band floor + referralSink + 7s sniper escrow + 6-dec USDG + AnonLauncher v2.
RPC_URL=https://rpc.testnet.chain.robinhood.com
POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
V4_QUOTER=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
# UNIVERSAL_ROUTER removed (audit #10 / SEC-05): not a trusted router for hookData attribution.
# USDG / DEFAULT_QUOTE intentionally UNSET: the old mUSDG (0x2503…0644) and STRATEGY (0xd4d0…55a3) are 18-dec.
# Deploy.s.sol deploys a fresh mintable 6-dec mock USDG (like mainnet) + a test STRATEGY with a STRATEGY/USDG
# pricer pool at $0.00245 (~$1M per side). To reuse an existing 6-dec USDG instead, set USDG=0x… (and DEFAULT_QUOTE…).
USDG_DECIMALS=6
EXPECT_USDG_DECIMALS=6
REF_POOL_USD=1000000
# 0.25 USDG at 6 decimals (raw units).
ANON_LAUNCH_FEE=250000
# address(0) = today's routing. lee: the sink, when set later, takes the whole referral 1% incl. the launch-KOL 1%.
REFERRAL_SINK=0x0000000000000000000000000000000000000000
# Testnet (lee 2026-10-24 1:17 PM CT): TREASURY and REWARDS_VAULT_OWNER stay UNSET (deployer). PVE_ATTESTER is REQUIRED:
# export SITE's login-signer address before redeploy.sh (also used as PAYMASTER_SIGNER). Optional: MIN_LIQUIDITY.
# Redeploy pack (lee 2026-10-24): the legacy AntiSnipe is no longer deployed (Launchpad.antiSnipe = 0x0; addresses after
# Migration shift by one). FeeRouter.kolCreatorShareBps starts at 200 (owner setter, 0-500); smoke reads EXPECT_KOL_CREATOR_SHARE_BPS.
