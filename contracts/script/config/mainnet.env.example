# Robinhood Chain mainnet (4663) deploy config for script/Deploy.s.sol. No secrets in this file.
# Copy to mainnet.env, fill the three blanks, then: set -a; . script/config/mainnet.env; set +a
DISCIPLE_NETWORK=mainnet
DISCIPLE_CHAIN_ID=4663
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
V4_QUOTER=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
EXPECT_USDG_DECIMALS=6
# STRATEGY; all 12 pair coins are listed and routed by script/whitelist/MainnetRoutes.sol in the same broadcast
DEFAULT_QUOTE=0x168661C52E5922288dFb2b3f323b6Cf90eb21e18
# QuotePricer constructor floor for 6-dec USDG (1e4 * 10^12)
MIN_LIQUIDITY=10000000000000000
# $1 honeypot probe
PROBE_USDG=1000000
ERC5564_ANNOUNCER=0x55649E01B5Df198D18D95b5cc5051630cfD45564
# FILL IN: fee treasury Safe (must be a contract; Deploy refuses an EOA). Fixed forever in DiscipleHook (33% share) and LockedLP, so use the final treasury Safe.
TREASURY=0x2447C5065eEDA71ed6d4A2D0347b48eA3B211E30
# FILL IN: community rewards Safe (separate from the treasury; must be a deployed Safe). Fixed forever in DiscipleHook
# (1% share) and FeeRouter.referralSink (curve 1% + Easy no-holder tip); default owner of RewardsVault (sniper fees).
COMMUNITY_SAFE=0x0000000000000000000000000000000000000000  # PLACEHOLDER: maker to send the address
# FILL IN: the relayer EOA the Vercel crons sign with (poke-pricer, lp-flush)
PRICER_POKER=
# Optional: wallet paid the flat $0.01 USDG network fee on gasless trades. Default: PRICER_POKER (the relayer).
# GASLESS_FEE_TO=
# Optional: protocol Safe. Leave unset at launch; run script/HandoverToSafe.s.sol later.
# SAFE=
# REWARDS_VAULT_OWNER is ignored on mainnet: the RewardsVault owner is COMMUNITY_SAFE (nominated; the Safe must acceptOwnership)
